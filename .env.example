# Bu faylı .env.local adı ilə kopyala və doldur. .env.local heç vaxt commit olunmur.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Yalnız backend: miqrasiya işə salmaq üçün (session pooler sətri)
SUPABASE_DB_URL=

# Mətn modeli (qiymətləndirmə + mətn rejimində AI müştəri): claude | gemini
# Boş qalsa: ANTHROPIC_API_KEY varsa claude, yoxsa gemini.
LLM_PROVIDER=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gemini (aistudio.google.com → Get API key, pulsuz səviyyə)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Realtime — səsli zəng
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
