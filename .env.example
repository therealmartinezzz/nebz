# Bu faylı .env.local adı ilə kopyala və doldur. .env.local heç vaxt commit olunmur.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Yalnız backend: miqrasiya işə salmaq üçün (session pooler sətri)
SUPABASE_DB_URL=

# Claude — qiymətləndirmə və mətn rejimində AI müştəri
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI Realtime — səsli zəng
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
