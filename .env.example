# Bu faylı .env.local adı ilə kopyala və doldur. .env.local heç vaxt commit olunmur.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Yalnız backend: miqrasiya işə salmaq üçün (session pooler sətri)
SUPABASE_DB_URL=

# Bütün demo AI işləri eyni Gemini layihəsinin açarı ilə işləyir.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CUSTOMER_MODEL=gemini-3.5-flash-lite
GEMINI_SCORING_MODEL=gemini-3.8-flash
GEMINI_DRAFT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Açıq demo: maksimum 60 saniyə və 10 operator replikası.
GEMINI_LIVE_MAX_SECONDS=60
# $5 balansın bir hissəsini inkişaf və billing gecikmələri üçün saxlayırıq.
DEMO_AI_BUDGET_USD=3.5
DEMO_BUDGET_ID=hackathon-2026
# Brauzer başına limit gündə/dəqiqədə (opsional). Default: limitsiz — yalnız ümumi DEMO_AI_BUDGET_USD qoruyur.
# DEMO_LIMIT_VOICE=30/3
# Opsional HMAC sirri; boşdursa server service_role açarı istifadə edilir.
DEMO_LIMIT_SECRET=
